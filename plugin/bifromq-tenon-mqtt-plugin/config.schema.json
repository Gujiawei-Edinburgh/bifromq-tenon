{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint",
    "clientIdPrefix"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "pattern": "^mqtts?://[^/?#]+$"
    },
    "clientIdPrefix": {
      "type": "string",
      "minLength": 1
    },
    "eventLoopThreads": {
      "type": "integer",
      "minimum": 1
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username"
      ],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleanStart": { "type": "boolean" },
        "expiryIntervalSeconds": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptions"
      ],
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filter"
            ],
            "properties": {
              "filter": {
                "type": "string",
                "minLength": 1
              },
              "qos": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        "maxPendingMessages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultQos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "defaultRetain": {
          "type": "boolean"
        }
      }
    }
  }
}
