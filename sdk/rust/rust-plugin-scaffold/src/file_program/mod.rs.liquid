//! Owns this program's business resources for one SDK-managed lifetime.

use crate::{output::Output, payload::SinkRecordPayload};
{% if interface == "source-and-sink" %}use crate::{payload::SourceRecordPayload, source::Source};
use std::sync::Mutex;
{% endif %}
use std::{future::ready, path::Path};
{% if interface == "sink" %}use tenon_plugin_sdk::TenonSink;
{% endif %}use tenon_plugin_sdk::{Error, FlowChannel, Value};
{% if interface == "source-and-sink" %}use tenon_plugin_sdk::{PayloadSender, TenonSource, TenonSourceAndSink};
{% endif %}
pub(super) struct FileProgram {
    output: Output,
{% if interface == "source-and-sink" %}    source: Mutex<Source>,
{% endif %}}

impl FileProgram {
{% if interface == "source-and-sink" %}    pub(super) fn new(
        config: Value,
        sender: PayloadSender<SourceRecordPayload>,
    ) -> Result<Self, Error> {
{% else %}    pub(super) fn new(config: Value) -> Result<Self, Error> {
{% endif %}        let path = config["outputFile"]
            .as_str()
            .expect("config.schema.json requires an absolute output path");
        Ok(Self {
            output: Output::open(Path::new(path))?,
{% if interface == "source-and-sink" %}            source: Mutex::new(Source::new(&config, sender)),
{% endif %}        })
    }
}

{% if interface == "source-and-sink" %}impl TenonSourceAndSink<SinkRecordPayload> for FileProgram {
    fn start(&mut self) {
        self.source
            .get_mut()
            .expect("Source lock must not panic")
            .start();
    }

    fn quiesce(&self) {
        self.source
            .lock()
            .expect("Source lock must not panic")
            .quiesce();
    }
{% else %}impl TenonSink<SinkRecordPayload> for FileProgram {
    fn start(&mut self) {}
{% endif %}
    fn write(
        &self,
        _channel: FlowChannel,
        records: Box<[SinkRecordPayload]>,
    ) -> impl Future<Output = Result<(), Error>> {
        ready(self.output.write(&records))
    }

    fn close(&mut self) {
{% if interface == "source-and-sink" %}        self.source
            .get_mut()
            .expect("Source lock must not panic")
            .close();
{% endif %}        // Every successful batch is already durable; dropping this owner closes the file.
    }
}
